#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
project_dir="${MINIMAX_H3_PROJECT_DIR:-$plugin_dir/runtime}"

if [ ! -f "$project_dir/scripts/h3-provision.mjs" ]; then
  echo "插件 Runtime 不完整：$project_dir" >&2
  exit 1
fi

exec node "$project_dir/scripts/h3-provision.mjs" "$@"
